# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase/PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/postgres

# JWT signing key
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# Fernet key that encrypts stored website passwords
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

# Only during a key rotation: the previous ENCRYPTION_KEY, so old data can still be decrypted
# OLD_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:3000
